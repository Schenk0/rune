{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rune",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.html", "**/*.txt", "**/*.svg"], "fallthrough": true }],
  "ratelimits": [
    { "name": "READ_LIMITER", "namespace_id": "9202101", "simple": { "limit": 240, "period": 60 } },
    { "name": "WRITE_LIMITER", "namespace_id": "9202102", "simple": { "limit": 30, "period": 60 } }
  ],
  "secrets": {
    "required": ["UPLOAD_TOKEN"]
  },
  "vars": {
    "API_HOST": "api.rune.page",
    "PUBLIC_DOMAIN": "rune.page",
    "PUBLIC_ORIGIN": "https://rune.page"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "rune-files"
    }
  ],
  "env": {
    "local": {
      "ratelimits": [
        { "name": "READ_LIMITER", "namespace_id": "9202101", "simple": { "limit": 240, "period": 60 } },
        { "name": "WRITE_LIMITER", "namespace_id": "9202102", "simple": { "limit": 30, "period": 60 } }
      ],
      "routes": [],
      "vars": { "API_HOST": "localhost", "PUBLIC_DOMAIN": "localhost", "PUBLIC_ORIGIN": "http://localhost:8787" },
      "secrets": { "required": ["UPLOAD_TOKEN"] },
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "rune-local" }]
    }
  },
  "routes": [
    { "pattern": "rune.page/*", "zone_name": "rune.page" },
    {
      "pattern": "*.rune.page/*",
      "zone_name": "rune.page"
    }
  ]
}
