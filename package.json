{
  "name": "rune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "rune": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json && chmod +x dist/cli.js",
    "check": "pnpm run typecheck && pnpm run test && pnpm run test:cli",
    "cf-typegen": "wrangler types",
    "dev": "wrangler dev --env local",
    "test": "vitest run",
    "test:cli": "pnpm run build && node --test test/cli.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.13",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.0.8"
}
